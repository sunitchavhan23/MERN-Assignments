<!doctype html>
<html lang="en" data-bs-theme="light">

<head>
    <title>Add Course | CourseHub</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous" />
    <link rel="stylesheet" href="/styles.css" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light">
            <div class="container">
                <a class="navbar-brand" href="/dashboard">Course Management System</a>
                <button class="navbar-toggler d-lg-none" type="button" data-bs-toggle="collapse"
                    data-bs-target="#collapsibleNavId" aria-controls="collapsibleNavId" aria-expanded="false"
                    aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="collapsibleNavId">
                    <ul class="navbar-nav me-auto mt-2 mt-lg-0">
                        <li class="nav-item">
                            <a class="nav-link active" href="/dashboard">Back</a>
                        </li>
                    </ul>
                    <div class="d-flex my-2 my-lg-0 gap-2">
                        <span class="badge-soft">Hello,<%= uname %></span>
                        <a class="btn btn-primary" href="/logout" role="button">Logout</a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main class="page-shell">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-6 col-md-8">
                    <div class="hero-card text-center">
                        <h3>Add Course</h3>

                    </div>
                    <div class="form-card">
                        <form action="/addCourse" method="post">
                            <div class="form-floating mb-3">
                                <input type="text" class="form-control" name="cname" id="courseName" placeholder="Course Name" />
                                <label for="courseName">Course Name</label>
                            </div>

                            <div class="form-floating mb-3">
                                <input type="text" class="form-control" name="tname" id="trainerName" placeholder="Trainer Name" />
                                <label for="trainerName">Trainer Name</label>
                            </div>

                            <div class="form-floating mb-3">
                                <input type="text" class="form-control" name="duration" id="duration" placeholder="Duration" />
                                <label for="duration">Duration</label>
                            </div>

                            <div class="form-floating mb-3">
                                <input type="number" class="form-control" name="fees" id="fees" placeholder="Fees" />
                                <label for="fees">Fees</label>
                            </div>

                            <button type="submit" class="btn btn-primary w-100">Add Course</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </main>

    

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
        crossorigin="anonymous"></script>
</body>

</html>