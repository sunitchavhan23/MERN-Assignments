<!doctype html>
<html lang="en" data-bs-theme="light">

<head>
    <title>Course Dashboard</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous" />
    <link rel="stylesheet" href="/styles.css" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light">
            <div class="container">
                <a class="navbar-brand" href="/dashboard">Course Management System</a>
                <button class="navbar-toggler d-lg-none" type="button" data-bs-toggle="collapse"
                    data-bs-target="#collapsibleNavId" aria-controls="collapsibleNavId" aria-expanded="false"
                    aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="collapsibleNavId">
                    <ul class="navbar-nav me-auto mt-2 mt-lg-0">
                        <li class="nav-item">
                            <a class="nav-link active" href="/addCourse" aria-current="page">Add Course</a>
                        </li>
                    </ul>
                    <div class="d-flex my-2 my-lg-0 gap-2">
                        <span class="badge-soft">Hello, <%= uname %></span>
                        <a class="btn btn-primary" href="/logout" role="button">Logout</a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main class="page-shell">
        <div class="container">
            <div class="hero-card">
                <h3>Course Dashboard</h3>
            </div>

            <div class="table-card">
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th>Course Name</th>
                                <th>Trainer Name</th>
                                <th>Duration</th>
                                <th>Fees</th>
                                <th>Action</th>
                                <th>Manage</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% result.forEach(course=>{ %>
                                <tr>
                                    <td><%= course.cname %></td>
                                    <td><%= course.tname %></td>
                                    <td><%= course.duration %></td>
                                    <td><%= course.fees %></td>
                                    <td>
                                        <% if (course.userId && course.userId.toString() === userId) { %>
                                            <a href="/edit/<%= course._id %>" class="btn btn-outline-primary btn-sm">Edit</a>
                                        <% } else { %>
                                            -
                                        <% } %>
                                    </td>
                                    <td>
                                        <% if (course.userId && course.userId.toString() === userId) { %>
                                            <form action="/delete/<%= course._id %>?_method=DELETE" method="POST" class="m-0">
                                                <button class="btn btn-danger btn-sm " onclick="return confirm('Are you sure you want to delete ?');">Delete</button>
                                            </form>
                                        <% } else { %>
                                            -
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </main>

    <footer></footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
        crossorigin="anonymous"></script>
</body>

</html>