<!doctype html>
<html lang="en" data-bs-theme="light">

<head>
    <title>Add Room</title>
    <!-- Required meta tags -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Bootstrap CSS v5.3.8 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous" />
</head>

<body>
    <header>
        <!-- place navbar here -->
        <nav class="navbar navbar-expand-sm navbar-light bg-light">
            <div class="container">
                <a class="navbar-brand" href="#">Hotel Room Management System</a>
                <button class="navbar-toggler d-lg-none" type="button" data-bs-toggle="collapse"
                    data-bs-target="#collapsibleNavId" aria-controls="collapsibleNavId" aria-expanded="false"
                    aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="collapsibleNavId">
                    <ul class="navbar-nav me-auto mt-2 mt-lg-0">

                    </ul>
                    <form class="d-flex my-2 my-lg-0">
                        <a name="" id="" class="btn btn-secondary me-3" href="/dashboard" role="button">Back</a>

                        <a name="" id="" class="btn btn-success" href="/logout" role="button">Logout</a>

                    </form>
                </div>
            </div>
        </nav>
    </header>
    <main>
        <div class="container text-center rounded bordered shadow py-2 my-2 col-6">
            <h5>Add Rooms Here </h5>
        </div>

        <div class="container text-center py-2 my-2 rounded bordered shadow col-6">
            <form action="/addRoom" method="post">
                <div class="form-floating mb-3">
                    <input type="text" class="form-control" name="rnum" id="rnum" placeholder="" />
                    <label for="formId1">Room Number</label>
                </div>

                <div class="form-floating mb-3">
                    <input type="text" class="form-control" name="image" id="image" placeholder="" />
                    <label for="formId1">Image</label>
                </div>

                <div class="form-floating mb-3">
                    <input type="text" class="form-control" name="rtype" id="rtype" placeholder="" />
                    <label for="formId1">Room Type</label>
                </div>

                <div class="form-floating mb-3">
                    <input type="text" class="form-control" name="price" id="price" placeholder="" />
                    <label for="formId1">Price</label>
                </div>

                <div class="form-floating mb-3">
                    <input type="text" class="form-control" name="capacity" id="capacity" placeholder="" />
                    <label for="formId1">Capacity</label>
                </div>

                <button type="submit" class="btn btn-primary">
                    Add Room
                </button>

                <button type="reset" class="btn btn-primary">
                    Reset
                </button>




            </form>
        </div>


    </main>
    <footer>
        <!-- place footer here -->
    </footer>
    <!-- Bootstrap JavaScript Bundle (includes Popper) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
        crossorigin="anonymous"></script>
</body>

</html>